# Server-side only. Get one at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-key-here

# Optional overrides
MISTRAL_API_URL=https://api.mistral.ai
MISTRAL_MODEL=mistral-small-latest

# Optional vision fallback: when a message contains images and the selected
# model can't see them, the request is routed to this vision-capable provider
# instead. Free options:
#
# Google Gemini (free API key, no card): https://aistudio.google.com/apikey
# VISION_API_KEY=your_google_key
# VISION_MODEL=gemini-2.5-flash
# VISION_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
# Or Mistral Pixtral: https://console.mistral.ai/api-keys
# VISION_API_KEY=your-mistral-key
# VISION_MODEL=pixtral-12b-2409
# VISION_API_URL=https://api.mistral.ai

# ------------------------------------------------------------------
# Sign-in with Google / Apple (optional). Each provider only appears
# once both of its variables are set. Generate AUTH_SECRET with:
#   openssl rand -base64 32
#
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: <your-app-url>/api/auth/callback/google
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
#
# Apple (requires Apple Developer Program): https://developer.apple.com/account
#   Authorized redirect URI: <your-app-url>/api/auth/callback/apple
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=

# ------------------------------------------------------------------
# Works with any OpenAI-compatible provider — just change the three
# variables above. Example for Groq (https://console.groq.com/keys):
#
# MISTRAL_API_KEY=gsk_your_groq_key
# MISTRAL_API_URL=https://api.groq.com/openai/v1
# MISTRAL_MODEL=openai/gpt-oss-20b
#
# Example for a local Ollama model (https://ollama.com):
#
# MISTRAL_API_KEY=ollama
# MISTRAL_API_URL=http://localhost:11434/v1
# MISTRAL_MODEL=llama3.2
#
# Check your provider's model list if a model name stops working —
# providers retire old models regularly.
# ------------------------------------------------------------------
